# APP
PORT=3000
NODE_ENV=development
APP_NAME=EventTicketingAPI

# DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=yourpassword
DB_NAME=event_ticketing

# AUTH
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
QR_SIGNING_SECRET=

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379

# FLUTTERWAVE
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_WEBHOOK_HASH=

# STORAGE (Cloudflare R2 — S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# EMAIL
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yourdomain.com
